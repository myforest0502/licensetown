        "question_text": "基本的立位姿勢を矢状面から観察した場合、重心線が通るのはどこか。",
        "choices": {
          "1": "後頭隆起",
          "2": "烏口突起",
          "3": "大転子前方",
          "4": "膝蓋骨前方",
          "5": "外果前方"
        },
        "exam": {
          "exam_no": 58,
          "session": "午後",
          "question_no": 73
        }
      },
      "answer": {
        "id": "Q1272",
